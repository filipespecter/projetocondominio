generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
  CONDOMINIUM_ADMIN
  MANAGER
  DOORMAN
  RESIDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING
}

enum CondominiumStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELED
  PENDING
  REJECTED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  OVERDUE
  SUSPENDED
  CANCELED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum FeatureValueType {
  BOOLEAN
  LIMIT
  CONFIGURATION
}

enum ApartmentStatus {
  OCCUPIED
  VACANT
  MAINTENANCE
  INACTIVE
}

enum ResidentType {
  OWNER
  TENANT
  DEPENDENT
  OTHER
}

enum WorkShift {
  MORNING
  AFTERNOON
  NIGHT
  TWELVE_BY_THIRTY_SIX
  OTHER
}

enum VisitorStatus {
  WAITING
  AUTHORIZED
  INSIDE
  EXITED
  DENIED
  CANCELED
}

enum PackageStatus {
  EXPECTED
  RECEIVED
  DELIVERED
  CANCELED
}

enum PackagePickupMethod {
  QR
  CODE
}

enum PackagePickupPersonType {
  PRIMARY_RESIDENT
  DEPENDENT_RESIDENT
  OTHER_PERSON
}

enum ReservationStatus {
  PENDING
  APPROVED
  DENIED
  CANCELED
  COMPLETED
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NoticeAudience {
  ALL
  RESIDENTS
  DOORMEN
  MANAGERS
  APARTMENT
}

enum OccurrenceOrigin {
  RESIDENT
  DOORMAN
  MANAGER
  SYSTEM
}

enum OccurrenceType {
  OCCURRENCE
  COMPLAINT
  SUGGESTION
  REQUEST
}

enum OccurrencePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OccurrenceStatus {
  NEW
  FORWARDED
  IN_REVIEW
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ServiceProviderStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ProviderAccessStatus {
  SCHEDULED
  INSIDE
  EXITED
  CANCELED
}


enum PaymentMethodType {
  CARD
  PIX
  BOLETO
}

enum PaymentMethodPriority {
  PRIMARY
  SECONDARY
}

enum PaymentMethodStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum ChargeStatus {
  PENDING
  PAID
  OVERDUE
  FAILED
  CANCELED
  REFUNDED
}

enum PaymentTransactionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
  REFUNDED
  CHARGEBACK
  ERROR
}

enum SupportSessionStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum CommunicationChannel {
  WHATSAPP
  EMAIL
}

enum CommunicationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  CANCELED
}

enum JobExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELED
}

enum BackupStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  VERIFIED
}

enum BackupTrigger {
  AUTOMATIC
  MANUAL
}

enum SystemEventSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model Plan {
  id                  String       @id @default(uuid()) @db.Uuid
  name                String
  code                String       @unique
  description         String?
  monthlyPriceInCents Int
  billingCycle        BillingCycle @default(MONTHLY)
  active              Boolean      @default(true)
  displayOrder        Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  subscriptions Subscription[]
  planFeatures  PlanFeature[]

  @@index([active])
  @@index([displayOrder])
  @@index([deletedAt])
}

model Feature {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  valueType   FeatureValueType @default(BOOLEAN)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  planFeatures PlanFeature[]

  @@index([active])
  @@index([deletedAt])
}

model PlanFeature {
  planId    String @db.Uuid
  featureId String @db.Uuid

  enabled    Boolean @default(true)
  limitValue Int?
  config     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@index([featureId])
  @@index([planId, enabled])
}

model Condominium {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique

  name        String
  legalName   String?
  document    String? @unique
  email       String?
  phone       String?
  contactName String?

  postalCode    String?
  addressLine   String?
  addressNumber String?
  addressExtra  String?
  neighborhood  String?
  city          String?
  state         String?

  logoUrl  String?
  timezone String  @default("America/Recife")
  rules    String?
  settings Json?

  status       CondominiumStatus @default(PENDING)
  trialEndsAt  DateTime?
  activatedAt  DateTime?
  suspendedAt  DateTime?
  canceledAt   DateTime?

  approvedAt       DateTime?
  approvedByUserId String? @db.Uuid
  rejectedAt       DateTime?
  rejectedByUserId String? @db.Uuid
  rejectionReason  String?
  platformNotes    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users            User[] @relation("CondominiumUsers")
  subscriptions    Subscription[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  paymentMethods   PaymentMethod[]
  charges          Charge[]
  apartments       Apartment[]
  residents        Resident[]
  doormen           Doorman[]
  visitors          Visitor[]
  packages          Package[]
  commonAreas       CommonArea[]
  reservations      Reservation[]
  notices           Notice[]
  occurrences       Occurrence[]
  occurrenceReplies OccurrenceReply[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  serviceProviders  ServiceProvider[]
  providerAccesses  ProviderAccess[]
  operationalRecords OperationalRecord[]
  supportSessions   SupportSession[]
  supportTickets    SupportTicket[]
  communicationLogs CommunicationLog[]
  jobExecutions     JobExecution[]
  systemEvents      SystemEvent[]

  approvedBy User? @relation("CondominiumApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  rejectedBy User? @relation("CondominiumRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([approvedAt])
  @@index([rejectedAt])
  @@index([approvedByUserId])
  @@index([rejectedByUserId])
  @@index([deletedAt])
}

model Subscription {
  id            String @id @default(uuid()) @db.Uuid
  condominiumId String @db.Uuid
  planId        String @db.Uuid

  status       SubscriptionStatus @default(TRIAL)
  billingCycle BillingCycle       @default(MONTHLY)
  priceInCents Int

  billingContactName String?
  billingEmail       String?
  billingPhone       String?
  dueDay             Int?
  gracePeriodDays    Int     @default(30)
  autoSuspend        Boolean @default(true)

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  nextDueDate        DateTime?
  lastPaymentAt      DateTime?
  trialEndsAt        DateTime?
  suspendedAt        DateTime?
  canceledAt         DateTime?
  cancellationReason String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  plan        Plan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  charges     Charge[]

  @@index([condominiumId, status])
  @@index([planId])
  @@index([currentPeriodEnd])
  @@index([nextDueDate])
  @@index([status, currentPeriodEnd])
  @@index([status, nextDueDate])
}

model User {
  id            String  @id @default(uuid()) @db.Uuid
  condominiumId String? @db.Uuid

  name     String
  username String
  email    String?
  phone    String?
  document String?

  // Ficha interna da equipe Star Infinity Code.
  platformEmployeeCode   String?
  platformJobTitle       String?
  platformDepartment     String?
  platformEmploymentType String?
  platformStartDate      DateTime?
  platformNotes          String?

  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)

  mustChangePassword  Boolean @default(true)
  failedLoginAttempts Int     @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLogoutAt        DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  condominium       Condominium?      @relation("CondominiumUsers", fields: [condominiumId], references: [id], onDelete: Restrict)
  resident          Resident?
  doorman           Doorman?
  registeredVisitors Visitor[]        @relation("VisitorRegisteredBy")
  authorizedVisitors Visitor[]        @relation("VisitorAuthorizedBy")
  receivedPackages  Package[]         @relation("PackageReceivedBy")
  deliveredPackages Package[]         @relation("PackageDeliveredBy")
  requestedReservations Reservation[] @relation("ReservationRequestedBy")
  reviewedReservations  Reservation[] @relation("ReservationReviewedBy")
  authoredNotices    Notice[]          @relation("NoticeAuthor")
  createdOccurrences Occurrence[]      @relation("OccurrenceCreatedBy")
  assignedOccurrences Occurrence[]     @relation("OccurrenceAssignedTo")
  occurrenceReplies  OccurrenceReply[]
  notifications      Notification[]    @relation("NotificationRecipient")
  auditLogs           AuditLog[]        @relation("AuditLogUser")
  providerEntries     ProviderAccess[]  @relation("ProviderEntryRegisteredBy")
  providerExits       ProviderAccess[]  @relation("ProviderExitRegisteredBy")

  approvedCondominiums Condominium[] @relation("CondominiumApprovedBy")
  rejectedCondominiums Condominium[] @relation("CondominiumRejectedBy")
  supportSessions      SupportSession[] @relation("SupportSessionPlatformAdmin")
  openedSupportTickets SupportTicket[] @relation("SupportTicketOpenedBy")
  assignedSupportTickets SupportTicket[] @relation("SupportTicketAssignedTo")
  communicationsReceived CommunicationLog[] @relation("CommunicationRecipient")
  createdBackups       BackupRecord[] @relation("BackupCreatedBy")
  operationalRecordsCreated OperationalRecord[] @relation("OperationalRecordCreatedBy")
  originatedSystemEvents SystemEvent[] @relation("SystemEventUser")
  resolvedSystemEvents   SystemEvent[] @relation("SystemEventResolvedBy")

  @@unique([condominiumId, username])
  @@unique([condominiumId, email])
  @@index([condominiumId, role, status])
  @@index([condominiumId, document])
  @@index([role, status])
  @@index([platformEmployeeCode])
  @@index([deletedAt])
}

model Apartment {
  id            String @id @default(uuid()) @db.Uuid
  condominiumId String @db.Uuid

  block      String
  number     String
  floor      Int?
  status     ApartmentStatus @default(VACANT)
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  residents   Resident[]
  visitors    Visitor[]
  packages    Package[]
  reservations Reservation[]
  notices      Notice[]
  occurrences  Occurrence[]
  providerAccesses ProviderAccess[]

  @@unique([condominiumId, block, number])
  @@index([condominiumId, status])
  @@index([condominiumId, number])
  @@index([deletedAt])
}

model Resident {
  id            String @id @default(uuid()) @db.Uuid
  condominiumId String @db.Uuid
  apartmentId   String @db.Uuid
  userId        String @unique @db.Uuid

  residentType ResidentType @default(OWNER)
  isPrimary    Boolean      @default(false)
  canReserve   Boolean      @default(true)
  canOpenOccurrence Boolean @default(true)
  canViewPackages Boolean   @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  apartment   Apartment   @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  expectedPackages Package[] @relation("ExpectedPackageResident")
  pickedUpPackages Package[] @relation("PackagePickupResident")

  @@index([condominiumId, apartmentId])
  @@index([condominiumId, isPrimary])
  @@index([deletedAt])
}

model Doorman {
  id            String @id @default(uuid()) @db.Uuid
  condominiumId String @db.Uuid
  userId        String @unique @db.Uuid

  code          String
  shift         WorkShift
  customShift   String?
  lastDutyAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([condominiumId, code])
  @@index([condominiumId, shift])
  @@index([deletedAt])
}

model Visitor {
  id            String @id @default(uuid()) @db.Uuid
  condominiumId String @db.Uuid
  apartmentId   String @db.Uuid

  name       String
  document   String?
  phone      String?
  visitType  String?
  vehicle    String?
  plate      String?
  notes      String?
  status     VisitorStatus @default(WAITING)

  expectedAt   DateTime?
  enteredAt    DateTime?
  exitedAt     DateTime?
  authorizedAt DateTime?
  deniedAt     DateTime?

  registeredByUserId String? @db.Uuid
  authorizedByUserId String? @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  condominium     Condominium @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  apartment       Apartment   @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  registeredBy    User?       @relation("VisitorRegisteredBy", fields: [registeredByUserId], references: [id], onDelete: SetNull)
  authorizedBy    User?       @relation("VisitorAuthorizedBy", fields: [authorizedByUserId], references: [id], onDelete: SetNull)

  @@index([condominiumId, status])
  @@index([condominiumId, apartmentId, createdAt])
  @@index([document])
  @@index([deletedAt])
}

model Package {
  id            String @id @default(uuid()) @db.Uuid
  condominiumId String @db.Uuid
  apartmentId   String @db.Uuid
  expectedByResidentId String? @db.Uuid

  type          String
  description   String?
  carrier       String?
  trackingCode  String?
  status        PackageStatus @default(RECEIVED)
  withdrawnBy   String?
  notes         String?

  expectedAt    DateTime?
  receivedAt    DateTime?
  deliveredAt   DateTime?
  canceledAt    DateTime?

  receivedByUserId  String? @db.Uuid
  deliveredByUserId String? @db.Uuid

  // Credencial de retirada.
  // Somente hashes são persistidos.
  pickupTokenHash       String?
  pickupCodeHash        String?
  pickupGeneratedAt     DateTime?
  pickupUsedAt          DateTime?
  pickupMethod          PackagePickupMethod?

  // Identificação de quem efetivamente retirou.
  pickupPersonType      PackagePickupPersonType?
  pickupResidentId      String? @db.Uuid
  withdrawnDocument     String?
  withdrawnResidentBlock String?
  withdrawnResidentApartment String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  apartment   Apartment   @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  expectedByResident Resident? @relation("ExpectedPackageResident", fields: [expectedByResidentId], references: [id], onDelete: SetNull)
  pickupResident Resident? @relation("PackagePickupResident", fields: [pickupResidentId], references: [id], onDelete: SetNull)
  receivedBy  User?       @relation("PackageReceivedBy", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  deliveredBy User?       @relation("PackageDeliveredBy", fields: [deliveredByUserId], references: [id], onDelete: SetNull)

  deliveryProofFilePath String?
  deliveryProofMimeType String?

  @@index([condominiumId, status])
  @@index([condominiumId, apartmentId, status])
  @@index([pickupTokenHash])
  @@index([pickupCodeHash])
  @@index([pickupResidentId])
  @@index([trackingCode])
  @@index([createdAt])
  @@index([deletedAt])
}

model CommonArea {
  id            String @id @default(uuid()) @db.Uuid
  condominiumId String @db.Uuid

  name                String
  description         String?
  capacity            Int?
  openingTime         String?
  closingTime         String?
  reservationRequired Boolean @default(true)
  active              Boolean @default(true)
  rules               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@unique([condominiumId, name])
  @@index([condominiumId, active])
  @@index([deletedAt])
}

model Reservation {
  id            String @id @default(uuid()) @db.Uuid
  condominiumId String @db.Uuid
  commonAreaId  String @db.Uuid
  apartmentId   String @db.Uuid
  requestedByUserId String @db.Uuid
  reviewedByUserId  String? @db.Uuid

  reservationDate DateTime @db.Date
  startTime       String
  endTime         String
  guestsCount     Int?
  purpose         String?
  notes           String?
  status          ReservationStatus @default(PENDING)
  reviewReason    String?
  reviewedAt      DateTime?
  canceledAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  commonArea  CommonArea  @relation(fields: [commonAreaId], references: [id], onDelete: Restrict)
  apartment  Apartment   @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  requestedBy User       @relation("ReservationRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedBy  User?      @relation("ReservationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([condominiumId, reservationDate, status])
  @@index([condominiumId, commonAreaId, reservationDate])
  @@index([apartmentId, reservationDate])
  @@index([deletedAt])
}

model Notice {
  id            String @id @default(uuid()) @db.Uuid
  condominiumId String @db.Uuid
  authorUserId  String @db.Uuid
  apartmentId   String? @db.Uuid

  title       String
  message     String
  category    String?
  priority    NotificationPriority @default(NORMAL)
  audience    NoticeAudience       @default(ALL)
  status      NoticeStatus         @default(PUBLISHED)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  author      User        @relation("NoticeAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  apartment   Apartment?  @relation(fields: [apartmentId], references: [id], onDelete: SetNull)

  @@index([condominiumId, status, publishedAt])
  @@index([condominiumId, audience])
  @@index([apartmentId])
  @@index([deletedAt])
}

model Occurrence {
  id            String @id @default(uuid()) @db.Uuid
  condominiumId String @db.Uuid
  apartmentId   String? @db.Uuid
  createdByUserId String? @db.Uuid
  assignedToUserId String? @db.Uuid

  origin      OccurrenceOrigin
  type        OccurrenceType
  category    String
  priority    OccurrencePriority @default(MEDIUM)
  title       String
  description String
  status      OccurrenceStatus @default(NEW)
  shift       String?
  dutyDate    DateTime? @db.Date
  resolution  String?
  resolvedAt  DateTime?
  closedAt    DateTime?
  readByManagerAt DateTime?
  readByDoormanAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  apartment   Apartment?  @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  createdBy   User?       @relation("OccurrenceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignedTo  User?       @relation("OccurrenceAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  replies     OccurrenceReply[]

  @@index([condominiumId, status, priority])
  @@index([condominiumId, type, createdAt])
  @@index([apartmentId])
  @@index([createdByUserId])
  @@index([deletedAt])
}

model OccurrenceReply {
  id            String @id @default(uuid()) @db.Uuid
  condominiumId String @db.Uuid
  occurrenceId  String @db.Uuid
  authorUserId  String @db.Uuid

  message   String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  occurrence  Occurrence  @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([condominiumId, occurrenceId, createdAt])
  @@index([authorUserId])
  @@index([deletedAt])
}

model Notification {
  id            String @id @default(uuid()) @db.Uuid
  condominiumId String @db.Uuid
  recipientUserId String? @db.Uuid

  title       String
  message     String
  type        String
  origin      String?
  targetRole  UserRole?
  module      String?
  referenceId String?
  apartmentLabel String?
  priority    NotificationPriority @default(NORMAL)
  readAt      DateTime?
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  recipient   User?       @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([condominiumId, recipientUserId, readAt])
  @@index([condominiumId, targetRole, readAt])
  @@index([module, referenceId])
  @@index([createdAt])
}

model ExpenseCategory {
  id            String   @id @default(uuid()) @db.Uuid
  condominiumId String   @db.Uuid
  name          String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  expenses    Expense[]

  @@unique([condominiumId, name])
  @@index([condominiumId, active])
  @@index([deletedAt])
}

model Expense {
  id              String   @id @default(uuid()) @db.Uuid
  condominiumId   String   @db.Uuid
  categoryId      String   @db.Uuid
  expenseDate     DateTime
  description     String
  supplier        String?
  paymentMethod   String?
  amountInCents   Int
  notes            String?
  receiptFilePath  String?
  receiptMimeType  String?
  createdByUserId  String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  condominium Condominium   @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  category    ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([condominiumId, expenseDate])
  @@index([condominiumId, categoryId])
  @@index([deletedAt])
}


model PasswordResetCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([createdAt])
}

model AuditLog {
  id               String  @id @default(uuid()) @db.Uuid
  condominiumId    String? @db.Uuid
  userId           String? @db.Uuid
  supportSessionId String? @db.Uuid

  userName    String?
  userRole    UserRole?
  action      String
  module      String
  details     String?
  referenceId String?
  requestId   String?
  beforeData  Json?
  afterData   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  deletedAt   DateTime?
  deletedByUserId String? @db.Uuid
  deletionReason String?

  condominium  Condominium?   @relation(fields: [condominiumId], references: [id], onDelete: SetNull)
  user         User?           @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)
  supportSession SupportSession? @relation(fields: [supportSessionId], references: [id], onDelete: SetNull)

  @@index([condominiumId, createdAt])
  @@index([condominiumId, module, createdAt])
  @@index([userId, createdAt])
  @@index([supportSessionId, createdAt])
  @@index([requestId])
  @@index([referenceId])
  @@index([deletedAt])
}

model ServiceProvider {
  id            String @id @default(uuid()) @db.Uuid
  condominiumId String @db.Uuid

  name        String
  companyName String?
  document    String?
  phone       String?
  email       String?
  serviceType String
  notes       String?
  status      ServiceProviderStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  accesses    ProviderAccess[]

  @@index([condominiumId, status])
  @@index([condominiumId, document])
  @@index([deletedAt])
}

model ProviderAccess {
  id                String @id @default(uuid()) @db.Uuid
  condominiumId     String @db.Uuid
  serviceProviderId String @db.Uuid
  apartmentId       String? @db.Uuid

  serviceDescription String?
  scheduledDate      DateTime? @db.Date
  scheduledStartTime String?
  scheduledEndTime   String?
  status             ProviderAccessStatus @default(SCHEDULED)
  enteredAt          DateTime?
  exitedAt           DateTime?
  entryRegisteredByUserId String? @db.Uuid
  exitRegisteredByUserId  String? @db.Uuid
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  condominium    Condominium    @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  serviceProvider ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Restrict)
  apartment      Apartment?     @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  entryRegisteredBy User?       @relation("ProviderEntryRegisteredBy", fields: [entryRegisteredByUserId], references: [id], onDelete: SetNull)
  exitRegisteredBy  User?       @relation("ProviderExitRegisteredBy", fields: [exitRegisteredByUserId], references: [id], onDelete: SetNull)

  @@index([condominiumId, status, scheduledDate])
  @@index([serviceProviderId, createdAt])
  @@index([apartmentId])
  @@index([deletedAt])
}

model OperationalRecord {
  id            String @id @default(uuid()) @db.Uuid
  condominiumId String @db.Uuid

  recordDate      DateTime @db.Date
  recordTime      String
  responsibleName String
  previousReading Float?
  currentReading  Float?
  consumption     Float?
  wellStatus      String @default("Desligado")
  notes           String?
  createdByUserId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  createdBy User? @relation("OperationalRecordCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([condominiumId, recordDate])
  @@index([condominiumId, wellStatus])
  @@index([deletedAt])
}

model PaymentMethod {
  id            String @id @default(uuid()) @db.Uuid
  condominiumId String @db.Uuid

  type     PaymentMethodType
  priority PaymentMethodPriority
  status   PaymentMethodStatus @default(ACTIVE)

  provider                  String?
  providerCustomerId        String?
  providerPaymentMethodId   String?
  providerReference         String?

  cardBrand           String?
  cardLast4           String?
  cardExpirationMonth Int?
  cardExpirationYear  Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  charges     Charge[]

  @@unique([condominiumId, priority])
  @@index([condominiumId, type, status])
  @@index([provider, providerCustomerId])
  @@index([deletedAt])
}

model Charge {
  id              String @id @default(uuid()) @db.Uuid
  condominiumId   String @db.Uuid
  subscriptionId  String @db.Uuid
  paymentMethodId String? @db.Uuid

  status        ChargeStatus @default(PENDING)
  amountInCents Int
  dueDate       DateTime @db.Date

  provider         String?
  providerChargeId String?
  requestId        String?

  paymentUrl  String?
  boletoBarcode String?
  pixCopyPaste  String?

  paidAt     DateTime?
  overdueAt  DateTime?
  failedAt   DateTime?
  canceledAt DateTime?
  refundedAt DateTime?
  expiresAt  DateTime?

  failureReason String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  condominium  Condominium  @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]

  @@index([condominiumId, status, dueDate])
  @@index([subscriptionId, dueDate])
  @@index([paymentMethodId])
  @@index([provider, providerChargeId])
  @@index([requestId])
}

model PaymentTransaction {
  id       String @id @default(uuid()) @db.Uuid
  chargeId String @db.Uuid

  status        PaymentTransactionStatus @default(PENDING)
  amountInCents Int

  provider          String?
  providerPaymentId String?
  requestId         String?

  failureReason String?
  metadata      Json?
  processedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  charge Charge @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@index([chargeId, status, createdAt])
  @@index([provider, providerPaymentId])
  @@index([requestId])
}

model SupportSession {
  id                  String @id @default(uuid()) @db.Uuid
  platformAdminUserId String @db.Uuid
  condominiumId       String @db.Uuid

  status SupportSessionStatus @default(ACTIVE)
  reason String

  requestId      String?
  ipAddress      String?
  userAgent      String?
  startedAt      DateTime @default(now())
  lastActivityAt DateTime?
  endedAt        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  platformAdmin User        @relation("SupportSessionPlatformAdmin", fields: [platformAdminUserId], references: [id], onDelete: Restrict)
  condominium   Condominium @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
  auditLogs      AuditLog[]

  @@index([platformAdminUserId, status])
  @@index([condominiumId, status])
  @@index([requestId])
  @@index([startedAt])
}

model SupportTicket {
  id String @id @default(uuid()) @db.Uuid
  condominiumId String @db.Uuid
  openedByUserId String @db.Uuid
  assignedToUserId String? @db.Uuid

  ticketNumber Int @unique @default(autoincrement())
  title String
  description String
  category String
  priority SupportTicketPriority @default(MEDIUM)
  status SupportTicketStatus @default(OPEN)
  resolution String?
  metadata Json?
  openedAt DateTime @default(now())
  firstResponseAt DateTime?
  resolvedAt DateTime?
  closedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Restrict)
