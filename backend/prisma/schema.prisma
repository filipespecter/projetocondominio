  referenceId String?
  requestId   String?

  provider          String?
  providerMessageId String?

  attemptCount  Int @default(0)
  lastAttemptAt DateTime?
  sentAt        DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  canceledAt    DateTime?
  lastError     String?

