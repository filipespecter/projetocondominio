  storageKey      String?
  fileName        String?
  sizeBytes       BigInt?
  checksumSha256  String?

  startedAt   DateTime?
  completedAt DateTime?
  verifiedAt  DateTime?
  retentionUntil DateTime?

  failureReason String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User? @relation("BackupCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([trigger, createdAt])
  @@index([createdByUserId])
  @@index([retentionUntil])
}

model SystemEvent {
  id               String  @id @default(uuid()) @db.Uuid
  condominiumId    String? @db.Uuid
  userId           String? @db.Uuid
  resolvedByUserId String? @db.Uuid

  severity SystemEventSeverity @default(INFO)
  type     String
  source   String
  message  String

  requestId  String?
  errorCode  String?
  httpMethod String?
  route      String?
  statusCode Int?
  stack      String?

  details Json?

  occurredAt        DateTime @default(now())
  resolvedAt        DateTime?
  resolutionAction  String?
  resolutionComment String?
  resolutionNotes   String?
  createdAt         DateTime @default(now())
  updatedAt        DateTime @updatedAt

  condominium Condominium? @relation(fields: [condominiumId], references: [id], onDelete: SetNull)
  user        User? @relation("SystemEventUser", fields: [userId], references: [id], onDelete: SetNull)
  resolvedBy  User? @relation("SystemEventResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([severity, occurredAt])
  @@index([type, occurredAt])
  @@index([source, occurredAt])
  @@index([condominiumId, occurredAt])
  @@index([userId, occurredAt])
  @@index([requestId])
  @@index([resolvedAt])
}

