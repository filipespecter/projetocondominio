  assignedTo User? @relation("SupportTicketAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([condominiumId, status, openedAt])
  @@index([priority, status, openedAt])
  @@index([assignedToUserId, status])
}

model CommunicationLog {
  id              String  @id @default(uuid()) @db.Uuid
  condominiumId   String? @db.Uuid
