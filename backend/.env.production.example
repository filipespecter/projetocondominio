NODE_ENV=production
PORT=3333
FRONTEND_URL=https://condominio.example.com
# PostgreSQL interno deste Docker Compose. Use a mesma senha de POSTGRES_PASSWORD.
# Caracteres especiais na senha precisam de URL encoding nesta URL.
DATABASE_URL=postgresql://infinitycondo:SENHA_URL_ENCODED@postgres:5432/infinitycondo?schema=public
# Banco externo com TLS: use a configuração SSL exigida pelo provedor.
JWT_ACCESS_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-64-caracteres
JWT_REFRESH_SECRET=gere-outro-segredo-aleatorio-com-pelo-menos-64-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
TRUST_PROXY=1
WHATSAPP_ENABLED=false
MERCADO_PAGO_ENABLED=false

# Chave de 32 bytes em hexadecimal. Gere uma por ambiente e preserve-a junto do backup seguro.
MESSAGING_ENCRYPTION_KEY=

# Conexão guiada por condomínio. Valores privados somente no servidor.
# A criação/configuração e as aprovações do app na Meta são etapas externas obrigatórias.
META_APP_ID=
META_SIGNUP_CONFIG_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
META_PACKAGE_TEMPLATE=encomenda_recebida
# Callback único: https://SEU_DOMINIO/api/v1/webhooks/whatsapp
# Não altere MESSAGING_ENCRYPTION_KEY após cadastrar conexões sem migrar os segredos.
