NODE_ENV=production
PORT=3333
FRONTEND_URL=https://condominio.example.com
# PostgreSQL interno deste Docker Compose. Use a mesma senha de POSTGRES_PASSWORD.
# Caracteres especiais na senha precisam de URL encoding nesta URL.
DATABASE_URL=postgresql://infinitycondo:SENHA_URL_ENCODED@postgres:5432/infinitycondo?schema=public
# Banco externo com TLS: use a configuração SSL exigida pelo provedor.
JWT_ACCESS_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-64-caracteres
JWT_REFRESH_SECRET=gere-outro-segredo-aleatorio-com-pelo-menos-64-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
TRUST_PROXY=1
WHATSAPP_ENABLED=false
MERCADO_PAGO_ENABLED=false
