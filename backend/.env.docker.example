# ============================================================
# InfinityCondo - ambiente Docker LOCAL (homologacao)
# Copie para backend/.env.docker. Esse arquivo NUNCA vai para o Git.
# Os marcadores __GERAR_HEX64__ sao trocados por valores aleatorios
# pelo script docker/PRIMEIRA_INICIALIZACAO.ps1 (ou preencha a mao).
# Nao use aspas nem espacos nos valores.
# ============================================================

NODE_ENV=development
PORT=3333
# Precisa ser EXATAMENTE a URL que voce abre no navegador (CORS).
FRONTEND_URL=http://localhost:5173

# Host "postgres" = nome do servico no compose.yaml (porta interna 5432).
DATABASE_URL=postgresql://infinitycondo:infinitycondo_local@postgres:5432/infinitycondo_homolog?schema=public

JWT_ACCESS_SECRET=__GERAR_HEX64__
JWT_REFRESH_SECRET=__GERAR_HEX64__

# Conta da Central Star (somente DEV local)
PLATFORM_ADMIN_NAME=StarAdmin
PLATFORM_ADMIN_USERNAME=staradmin
PLATFORM_ADMIN_EMAIL=admin@infinitycondo.local
PLATFORM_ADMIN_PASSWORD=InfinityDocker!2026

# Chave que cifra as credenciais de WhatsApp de cada condominio (64 hex).
# Se trocar depois, as credenciais ja salvas deixam de abrir.
MESSAGING_ENCRYPTION_KEY=__GERAR_HEX64__

# Quantos proxies (Caddy, nginx) ficam na frente do backend.
# Sem isso, o backend enxerga todo mundo com o IP do proxy e os limites
# de acesso (300 req/min, 10 erros de login em 5 min) passam a valer
# para TODOS os usuarios juntos. 1 = um proxy na frente (Caddy OU nginx).
# Se houver dois (ex.: Caddy -> nginx -> backend), use 2.
TRUST_PROXY=1

# --- Flags de seguranca da homologacao (o teste homolog-integration.mjs exige false) ---
JOBS_ENABLED=false
WHATSAPP_ENABLED=false
MERCADO_PAGO_ENABLED=false

# URL publica da API (webhooks). Em producao, ex.: https://infinitycondo.tech. Se vazia, usa FRONTEND_URL.
# PUBLIC_API_URL=
# Log de cada consulta SQL do Prisma (muito volume). Deixe desligado.
# PRISMA_LOG_QUERIES=true

# --- E-mail (Resend) ---
# Deixe EMAIL_PROVIDER vazio para NAO enviar e-mail real.
# Em dev, o valor CONSOLE e recusado de proposito (erro 503).
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# --- Mercado Pago ---
# Atencao: com Access Token de PRODUCAO as cobrancas sao reais.
# MERCADO_PAGO_TIMEOUT_MS=20000
MERCADO_PAGO_ACCESS_TOKEN=
# ATENCAO: deixe COMENTADA ate ter o segredo real. Vazia (MERCADO_PAGO_WEBHOOK_SECRET=)
# a API NAO inicia, pois o schema exige 32+ caracteres quando a variavel existe.
# MERCADO_PAGO_WEBHOOK_SECRET=
# URL publica (tunel) para o Mercado Pago avisar pagamentos. Ex.: https://abc.ngrok-free.app/api/v1/webhooks/payments/mercado-pago
MERCADO_PAGO_WEBHOOK_URL=
# Somente para testes com o simulador (scripts/mock-mercadopago.mjs). Ignorada em producao.
# MERCADO_PAGO_API_BASE_URL=http://host.docker.internal:4010

# --- WhatsApp / Meta (conexao guiada do sindico) ---
META_APP_ID=
META_SIGNUP_CONFIG_ID=
# App Secret = 32 caracteres hex. Verify token = 32+ caracteres.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
META_PACKAGE_TEMPLATE=encomenda_recebida
# Somente para testes com o simulador (scripts/mock-whatsapp.mjs). Ignorada em producao.
# META_GRAPH_BASE_URL=http://host.docker.internal:4020
