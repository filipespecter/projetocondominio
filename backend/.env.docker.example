# =========================================================
# INFINITYCONDO - AMBIENTE LOCAL DOCKER / HOMOLOGACAO
# NAO USAR ESTES VALORES EM PRODUCAO.
# =========================================================
NODE_ENV=development
PORT=3333
FRONTEND_URL=http://localhost:5173

# Dentro do Docker, "postgres" e o nome do servico do banco.
DATABASE_URL=postgresql://infinitycondo:infinitycondo_local@postgres:5432/infinitycondo_homolog?schema=public

JWT_ACCESS_SECRET=DEV_ONLY_CHANGE_ME_ACCESS_123456789012345678901234567890
JWT_REFRESH_SECRET=DEV_ONLY_CHANGE_ME_REFRESH_12345678901234567890123456789
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
BCRYPT_ROUNDS=10

# Jobs podem ficar ligados na homologacao local.
JOBS_ENABLED=true
JOBS_TICK_INTERVAL_MS=60000

# Usuario inicial da Central Star - SOMENTE HOMOLOGACAO LOCAL.
PLATFORM_ADMIN_NAME=Star Docker Admin
PLATFORM_ADMIN_USERNAME=staradmin
PLATFORM_ADMIN_EMAIL=docker-admin@local.test
PLATFORM_ADMIN_PASSWORD=InfinityDocker!2026

# Integracoes externas: deixe vazias/desabilitadas ate a etapa de homologacao publica.
WHATSAPP_ENABLED=false
MERCADO_PAGO_ENABLED=false

# Garante planos mínimos para testar o fluxo Central -> aprovação no Docker local.
SEED_HOMOLOGATION_PLANS=true
