FROM node:22-alpine AS deps
WORKDIR /app
COPY package*.json prisma.config.ts ./
COPY prisma ./prisma
RUN npm ci --omit=dev && DATABASE_URL="postgresql://build:build@localhost:5432/build" node node_modules/prisma/build/index.js generate
FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup -S infinity && adduser -S infinity -G infinity
COPY --from=deps --chown=infinity:infinity /app/node_modules ./node_modules
COPY --chown=infinity:infinity package*.json prisma.config.ts ./
COPY --chown=infinity:infinity prisma ./prisma
COPY --chown=infinity:infinity src ./src
RUN mkdir -p uploads && chown infinity:infinity uploads
USER infinity
EXPOSE 3333
HEALTHCHECK --interval=30s --timeout=3s CMD node -e "fetch('http://127.0.0.1:3333/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node","src/server.js"]
